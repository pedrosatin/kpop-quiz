{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kpop-quiz.local/schemas/quiz-dataset-v2.json",
  "title": "K-pop quiz dataset v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_version",
    "generator_version",
    "template_version",
    "source_policy_version",
    "reference_date",
    "languages",
    "logical_question_count",
    "language_variant_count",
    "questions"
  ],
  "properties": {
    "schema_version": {"const": "kpop-quiz-dataset-v2"},
    "dataset_version": {"$ref": "#/$defs/hash"},
    "generator_version": {"type": "string", "minLength": 1},
    "template_version": {"type": "string", "minLength": 1},
    "source_policy_version": {"type": "string", "minLength": 1},
    "reference_date": {"type": "string", "format": "date"},
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["pt-BR", "en"]}
    },
    "logical_question_count": {"type": "integer", "minimum": 0},
    "language_variant_count": {"type": "integer", "minimum": 0},
    "questions": {
      "type": "array",
      "items": {"$ref": "#/$defs/question"}
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "value", "value_type"],
      "properties": {
        "id": {"$ref": "#/$defs/hash"},
        "label": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1},
        "value_type": {"enum": ["group", "person", "organization", "release", "time", "number"]}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_base_id", "locator", "revision_id", "source_key", "source_url"],
      "properties": {
        "fact_base_id": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "revision_id": {"type": "integer", "minimum": 1},
        "source_key": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    },
    "clue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence", "fact_base_ids", "id", "text", "type"],
      "properties": {
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "fact_base_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "id": {"$ref": "#/$defs/hash"},
        "text": {"type": "string", "minLength": 1},
        "type": {"const": "decade"}
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "logical_id",
        "base_logical_id",
        "semantic_id",
        "fact_base_ids",
        "language",
        "type",
        "theme",
        "play_mode",
        "challenge_rating",
        "base_points",
        "hint_cost",
        "clues_available",
        "clues_shown",
        "group_ids",
        "prompt",
        "options",
        "answer_option_id",
        "explanation",
        "reference_date",
        "evidence"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/hash"},
        "logical_id": {"$ref": "#/$defs/hash"},
        "base_logical_id": {"$ref": "#/$defs/hash"},
        "semantic_id": {"$ref": "#/$defs/hash"},
        "fact_base_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "language": {"enum": ["pt-BR", "en"]},
        "type": {
          "enum": [
            "formation_year",
            "member_at_date",
            "birth_date_or_place",
            "age_on_date",
            "group_for_member",
            "member_for_group",
            "group_for_record_label",
            "record_label_for_group",
            "chronological_comparison",
            "release_for_group",
            "group_for_release",
            "release_year",
            "earliest_release"
          ]
        },
        "theme": {"type": "string", "minLength": 1},
        "play_mode": {"enum": ["assisted", "standard", "expert"]},
        "challenge_rating": {"enum": ["easy", "medium", "hard"]},
        "base_points": {"type": "integer", "minimum": 1},
        "hint_cost": {"type": "integer", "minimum": 0},
        "clues_available": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/clue"}},
        "clues_shown": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}},
        "group_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "decades": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": [1990, 2000, 2010, 2020]}
        },
        "group_relevance_score": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 10000,
          "description": "Cached maximum relevance percentile score among the question groups."
        },
        "prompt": {"type": "string", "minLength": 1},
        "options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/option"}
        },
        "answer_option_id": {"$ref": "#/$defs/hash"},
        "explanation": {"type": "string", "minLength": 1},
        "reference_date": {"type": "string", "format": "date"},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "media": {
          "$ref": "licensed-media-v1.json"
        }
      }
    }
  }
}
