{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kpop-quiz.local/schemas/connections-puzzle-v1.json",
  "title": "K-pop quiz connections puzzle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "puzzle_id",
    "dataset_version",
    "reference_date",
    "dimensions",
    "categories",
    "items"
  ],
  "properties": {
    "schema_version": {"const": "kpop-connections-puzzle-v1"},
    "puzzle_id": {"$ref": "#/$defs/hash"},
    "dataset_version": {"$ref": "#/$defs/hash"},
    "reference_date": {"type": "string", "format": "date"},
    "dimensions": {"$ref": "#/$defs/dimensions"},
    "categories": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/category"}
    },
    "items": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "qid": {
      "type": "string",
      "pattern": "^Q[1-9][0-9]*$"
    },
    "bilingual_text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pt-BR", "en"],
      "properties": {
        "pt-BR": {"type": "string", "minLength": 1},
        "en": {"type": "string", "minLength": 1}
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groups", "items_per_group", "total_items"],
      "properties": {
        "groups": {"const": 4},
        "items_per_group": {"const": 4},
        "total_items": {"const": 16}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_base_id", "locator", "revision_id", "source_key", "source_url"],
      "properties": {
        "fact_base_id": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "revision_id": {"type": "integer", "minimum": 1},
        "source_key": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "difficulty_level", "item_ids", "explanation", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"$ref": "#/$defs/bilingual_text"},
        "difficulty_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "item_ids": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/qid"}
        },
        "explanation": {"$ref": "#/$defs/bilingual_text"},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "canonical_name", "labels"],
      "properties": {
        "id": {"$ref": "#/$defs/qid"},
        "canonical_name": {"type": "string", "minLength": 1},
        "labels": {"$ref": "#/$defs/bilingual_text"}
      }
    }
  }
}
