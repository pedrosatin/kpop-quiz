{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kpop-quiz.local/schemas/intersection-grid-v1.json",
  "title": "K-pop quiz intersection grid v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "grid_id",
    "dataset_version",
    "reference_date",
    "dimensions",
    "row_criteria",
    "col_criteria",
    "cells",
    "candidate_pool"
  ],
  "properties": {
    "schema_version": {"const": "kpop-intersection-grid-v1"},
    "grid_id": {"$ref": "#/$defs/hash"},
    "dataset_version": {"$ref": "#/$defs/hash"},
    "reference_date": {"type": "string", "format": "date"},
    "dimensions": {"$ref": "#/$defs/dimensions"},
    "row_criteria": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/criterion"}
    },
    "col_criteria": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/criterion"}
    },
    "cells": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {"$ref": "#/$defs/cell"}
    },
    "candidate_pool": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/candidate"}
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "qid": {
      "type": "string",
      "pattern": "^Q[1-9][0-9]*$"
    },
    "bilingual_text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pt-BR", "en"],
      "properties": {
        "pt-BR": {"type": "string", "minLength": 1},
        "en": {"type": "string", "minLength": 1}
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows", "cols"],
      "properties": {
        "rows": {"const": 3},
        "cols": {"const": 3}
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "label"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "category": {
          "type": "string",
          "enum": ["formed_on", "record_label", "has_member"]
        },
        "label": {"$ref": "#/$defs/bilingual_text"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_base_id", "locator", "revision_id", "source_key", "source_url"],
      "properties": {
        "fact_base_id": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "revision_id": {"type": "integer", "minimum": 1},
        "source_key": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_index", "col_index", "valid_entity_ids", "evidence"],
      "properties": {
        "row_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "col_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "valid_entity_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/qid"}
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "canonical_name", "names"],
      "properties": {
        "id": {"$ref": "#/$defs/qid"},
        "canonical_name": {"type": "string", "minLength": 1},
        "names": {"$ref": "#/$defs/bilingual_text"}
      }
    }
  }
}
