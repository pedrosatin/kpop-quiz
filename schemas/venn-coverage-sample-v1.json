{
  "type": "object",
  "required": [
    "schema_version",
    "rules_version",
    "dataset_version",
    "reference_date",
    "sample_id",
    "categories",
    "entities"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "rules_version": {
      "const": "venn-birth-coverage-v1"
    },
    "dataset_version": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reference_date": {
      "type": "string",
      "format": "date"
    },
    "sample_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "categories": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "id",
              "year",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "const": "birth_before_year"
              },
              "year": {
                "type": "integer",
                "minimum": 1
              },
              "label": {
                "type": "object",
                "required": [
                  "pt-BR",
                  "en"
                ],
                "additionalProperties": false,
                "properties": {
                  "pt-BR": {
                    "type": "string",
                    "minLength": 1
                  },
                  "en": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "enum": [
                  "birth_first_half",
                  "birth_first_fifteen_days"
                ]
              },
              "label": {
                "type": "object",
                "required": [
                  "pt-BR",
                  "en"
                ],
                "additionalProperties": false,
                "properties": {
                  "pt-BR": {
                    "type": "string",
                    "minLength": 1
                  },
                  "en": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        ]
      },
      "minItems": 3,
      "maxItems": 3
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "qid",
          "name",
          "birth_date",
          "state",
          "reasons",
          "evidence",
          "mask",
          "values"
        ],
        "additionalProperties": false,
        "properties": {
          "qid": {
            "type": "string",
            "pattern": "^Q[1-9][0-9]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "birth_date": {
            "type": "string",
            "format": "date"
          },
          "state": {
            "const": "known"
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "maxItems": 0
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "fact_base_id",
                "source_key",
                "locator",
                "revision_id",
                "source_url"
              ],
              "additionalProperties": false,
              "properties": {
                "fact_base_id": {
                  "type": "string",
                  "minLength": 1
                },
                "source_key": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "revision_id": {
                  "type": "integer",
                  "minimum": 1
                },
                "source_url": {
                  "type": "string",
                  "format": "uri"
                }
              }
            },
            "minItems": 1
          },
          "mask": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "values": {
            "type": "array",
            "items": {
              "type": "boolean"
            },
            "minItems": 3,
            "maxItems": 3
          }
        }
      },
      "minItems": 7,
      "maxItems": 7
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Venn factual coverage sample v1"
}
