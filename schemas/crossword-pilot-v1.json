{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kpop-quiz.local/schemas/crossword-pilot-v1.json",
  "title": "K-pop quiz crossword v1 (audited fixed board)",
  "description": "Structural contract of the crossword artifact. The domain rules this schema cannot express (SHA-256 identity, numbering, crossings, connectivity, alias collisions, cells derived from the entries, evidence URL matching the locator) live in kpop_scraping/crossword_cli.py validate() and web/src/data/crossword.ts validateCrosswordPuzzle(), which share the rejection cases in tests/fixtures/crossword_invalid_cases.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "puzzle_id",
    "dataset_version",
    "reference_date",
    "rows",
    "cols",
    "vocabulary",
    "audited_group_count",
    "entries",
    "cells"
  ],
  "properties": {
    "schema_version": {"const": "crossword-pilot-v1"},
    "mode": {"const": "pilot"},
    "puzzle_id": {"const": "crossword-audited-01"},
    "dataset_version": {"$ref": "#/$defs/hash"},
    "reference_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "format": "date"},
    "rows": {"type": "integer", "minimum": 1, "maximum": 9},
    "cols": {"type": "integer", "minimum": 1, "maximum": 9},
    "vocabulary": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/qid"}
    },
    "audited_group_count": {"type": "integer", "minimum": 3},
    "entries": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/entry"}
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/cell"}
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "qid": {"type": "string", "pattern": "^Q[1-9][0-9]*$"},
    "letter": {"type": "string", "pattern": "^[A-Z0-9]$"},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qid",
        "canonical_name",
        "aliases",
        "answer",
        "row",
        "col",
        "direction",
        "number",
        "clue",
        "matching_qids",
        "sources"
      ],
      "properties": {
        "qid": {"$ref": "#/$defs/qid"},
        "canonical_name": {"type": "string", "minLength": 1},
        "aliases": {"type": "array", "items": {"type": "string"}},
        "answer": {"type": "string", "pattern": "^[A-Z0-9]+$"},
        "row": {"type": "integer", "minimum": 0, "maximum": 8},
        "col": {"type": "integer", "minimum": 0, "maximum": 8},
        "direction": {"enum": ["across", "down"]},
        "number": {"type": "integer", "minimum": 1},
        "clue": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pt-BR", "en"],
          "properties": {
            "pt-BR": {"type": "string", "pattern": "\\S"},
            "en": {"type": "string", "pattern": "\\S"}
          }
        },
        "matching_qids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"$ref": "#/$defs/qid"}
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source"}
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "locator", "snippet", "statement_id", "predicate", "value"],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://[a-z]{2,3}(-[a-z]+)?\\.wikipedia\\.org/w/index\\.php\\?curid=[1-9][0-9]*&oldid=[1-9][0-9]*$"
        },
        "locator": {
          "type": "string",
          "pattern": "^wikipedia:[a-z]{2,3}(-[a-z]+)?:pageid=[1-9][0-9]*:revid=[1-9][0-9]*#(extract|wikitext)\\[[0-9]+:[0-9]+\\]$"
        },
        "snippet": {"type": "string", "minLength": 1},
        "statement_id": {"type": "string", "pattern": "^Q[1-9][0-9]*\\$"},
        "predicate": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row", "col", "answer"],
      "properties": {
        "row": {"type": "integer", "minimum": 0, "maximum": 8},
        "col": {"type": "integer", "minimum": 0, "maximum": 8},
        "answer": {"$ref": "#/$defs/letter"}
      }
    }
  }
}
