{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kpop-quiz.local/schemas/name-guess-v1.json",
  "title": "K-pop quiz name guess puzzle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "puzzle_id",
    "dataset_version",
    "reference_date",
    "word_length",
    "max_attempts",
    "target",
    "valid_guesses"
  ],
  "properties": {
    "schema_version": {"const": "kpop-name-guess-puzzle-v1"},
    "puzzle_id": {"$ref": "#/$defs/hash"},
    "dataset_version": {"$ref": "#/$defs/hash"},
    "reference_date": {"type": "string", "format": "date"},
    "word_length": {
      "type": "integer",
      "minimum": 3,
      "maximum": 10
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 4,
      "maximum": 8
    },
    "target": {"$ref": "#/$defs/target"},
    "valid_guesses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z]+$"
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "qid": {
      "type": "string",
      "pattern": "^Q[1-9][0-9]*$"
    },
    "bilingual_text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pt-BR", "en"],
      "properties": {
        "pt-BR": {"type": "string", "minLength": 1},
        "en": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_base_id", "locator", "revision_id", "source_key", "source_url"],
      "properties": {
        "fact_base_id": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "revision_id": {"type": "integer", "minimum": 1},
        "source_key": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    },
    "clues": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "debut_year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "agency": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"$ref": "#/$defs/bilingual_text"}
          ]
        },
        "members_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "description": {"$ref": "#/$defs/bilingual_text"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "canonical_name", "normalized_name", "labels", "entity_type", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/qid"},
        "canonical_name": {"type": "string", "minLength": 1},
        "normalized_name": {
          "type": "string",
          "pattern": "^[A-Z]+$"
        },
        "labels": {"$ref": "#/$defs/bilingual_text"},
        "entity_type": {
          "type": "string",
          "enum": ["group", "person"]
        },
        "clues": {"$ref": "#/$defs/clues"},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        }
      }
    }
  }
}
