{
  "name": "kpop-quiz-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:ci": "playwright test --project=chromium",
    "test:e2e:boot": "playwright test smoke --project=chromium",
    "test:e2e:playthrough": "playwright test playthrough --project=chromium",
    "test:e2e:nightly": "playwright test smoke --project=firefox --project=webkit",
    "test:e2e:staging": "BASE_URL=${STAGING_BASE_URL:-https://pedrosatin.github.io/kpop-quiz/} playwright test --project=chromium",
    "test:e2e:prod": "BASE_URL=https://kpopquiz.online playwright test --project=chromium",
    "playwright:install": "playwright install chromium",
    "artifacts:verify": "cd .. && python -m kpop_scraping.web_publish --output-dir web/public/data --verify --require-connections --require-name-guess --require-word-search --require-timeline",
    "seo:verify": "node scripts/seo-verify.mjs",
    "csp:verify": "node scripts/csp-verify.mjs",
    "og:generate": "node scripts/generate-og.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.5",
    "astro": "^7.3.5",
    "preact": "^10.27.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^24.3.1",
    "axe-core": "^4.13.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.2",
    "vitest": "^5.0.3"
  }
}
