---
import "../styles/global.css";
import type { Locale } from "../lib/quiz-types";
import type { SeoRouteKey, SkipLinkKey } from "../i18n/catalog";
import { getMessages } from "../i18n/catalog";
import {
  SEO_DEFAULT_PATH,
  SEO_OG_IMAGE_PATH,
  SEO_PROD_ORIGIN,
  seoOgLocale,
} from "../lib/seo-routes";
import { StatsNavTrigger } from "../components/Stats/StatsNavTrigger";
import { OPEN_CONSENT_PREFERENCES_EVENT } from "../components/Consent/ConsentBanner";
import { ConsentBanner } from "../components/Consent/ConsentBanner";

interface Props {
  locale: Locale;
  route: SeoRouteKey;
  canonicalPath: string;
  alternatePath: string;
  indexable?: boolean;
  showGameNavigation?: boolean;
  pageMeta?: { title: string; description: string };
}
const {
  locale,
  route,
  canonicalPath,
  alternatePath,
  indexable = true,
  showGameNavigation = true,
  pageMeta,
} = Astro.props;
const messages = getMessages(locale);
const meta = pageMeta ?? messages.meta[route];
const canonicalUrl = `${SEO_PROD_ORIGIN}${canonicalPath}`;
const alternateUrl = `${SEO_PROD_ORIGIN}${alternatePath}`;
const defaultUrl = `${SEO_PROD_ORIGIN}${SEO_DEFAULT_PATH}`;
const ogImageUrl = `${SEO_PROD_ORIGIN}${SEO_OG_IMAGE_PATH}`;
const ogLocale = seoOgLocale(locale);
const ogLocaleAlternate = seoOgLocale(locale === "pt-BR" ? "en" : "pt-BR");
const isGrid = Astro.url.pathname.includes("/grid");
const isConnections = Astro.url.pathname.includes("/conexoes") || Astro.url.pathname.includes("/connections");
const isNameGuess = Astro.url.pathname.includes("/adivinhe") || Astro.url.pathname.includes("/guess");
const isWordSearch = Astro.url.pathname.includes("/caca-palavras") || Astro.url.pathname.includes("/word-search");
const isMapPilot = Astro.url.pathname.includes("/mapa") || Astro.url.pathname.includes("/map/");
const isPrivacy = canonicalPath.endsWith("/privacidade/") || canonicalPath.endsWith("/privacy/");
const skipTarget = isPrivacy
  ? "#privacy-notice"
  : (isMapPilot
  ? "#map-game"
  : (isWordSearch
  ? "#word-search"
  : (isNameGuess ? "#name-guess" : (isConnections ? "#connections" : (isGrid ? "#grid" : "#quiz")))));
const targetBase = locale === "pt-BR" ? "/en/" : "/pt-br/";
let otherPath = isPrivacy
  ? (locale === "pt-BR" ? "/en/privacy/" : "/pt-br/privacidade/")
  : targetBase;
if (isGrid) {
  otherPath = `${targetBase}grid/`;
} else if (isConnections) {
  otherPath = locale === "pt-BR" ? `${targetBase}connections/` : `${targetBase}conexoes/`;
} else if (isNameGuess) {
  otherPath = locale === "pt-BR" ? `${targetBase}guess/` : `${targetBase}adivinhe/`;
} else if (isWordSearch) {
  otherPath = locale === "pt-BR" ? `${targetBase}word-search/` : `${targetBase}caca-palavras/`;
} else if (isMapPilot) {
  otherPath = locale === "pt-BR" ? `${targetBase}map/` : `${targetBase}mapa/`;
}
const skipLinkKey: SkipLinkKey = isPrivacy
  ? "privacy"
  : (isMapPilot
  ? "mapPilot"
  : (isWordSearch
  ? "wordSearch"
  : (isNameGuess ? "nameGuess" : (isConnections ? "connections" : (isGrid ? "grid" : "quiz")))));
const skipLinkText = messages.skipLinks[skipLinkKey];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// Only the production build is served from the root; prefixed builds are staging.
const isStaging = base !== "";
// Cloudflare Web Analytics token. Missing/empty means no beacon is rendered.
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
const enableAnalytics = !isStaging && Boolean(cfBeaconToken);
// Google Analytics 4 ID. The banner below only mounts in this case; the
// scripts load at runtime after explicit consent (see ConsentBanner).
// Note: the static import emits an unreferenced banner chunk in builds where
// the island is not mounted (e.g. staging). It cannot execute without a
// <script> tag pointing at it, so the staging guard scans *.html (the
// executable surface) rather than the whole dist.
const ga4Id = import.meta.env.PUBLIC_GA4_ID;
const enableGa4 = !isStaging && Boolean(ga4Id);
const privacyPath = locale === "pt-BR" ? "/pt-br/privacidade/" : "/en/privacy/";
const isQuiz = !isGrid && !isConnections && !isNameGuess && !isWordSearch && !isMapPilot;
const games = [
  {
    id: "quiz",
    label: messages.gameQuiz,
    path: locale === "pt-BR" ? "/pt-br/" : "/en/",
    isActive: isQuiz,
  },
  {
    id: "grid",
    label: messages.gameGrid,
    path: locale === "pt-BR" ? "/pt-br/grid/" : "/en/grid/",
    isActive: isGrid,
  },
  {
    id: "connections",
    label: messages.gameConnections,
    path: locale === "pt-BR" ? "/pt-br/conexoes/" : "/en/connections/",
    isActive: isConnections,
  },
  {
    id: "name-guess",
    label: messages.gameNameGuess,
    path: locale === "pt-BR" ? "/pt-br/adivinhe/" : "/en/guess/",
    isActive: isNameGuess,
  },
  {
    id: "word-search",
    label: messages.gameWordSearch,
    path: locale === "pt-BR" ? "/pt-br/caca-palavras/" : "/en/word-search/",
    isActive: isWordSearch,
  },
];
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="pt-BR" href={locale === "pt-BR" ? canonicalUrl : alternateUrl} />
    <link rel="alternate" hreflang="en" href={locale === "en" ? canonicalUrl : alternateUrl} />
    <link rel="alternate" hreflang="x-default" href={defaultUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {(isStaging || !indexable) && <meta name="robots" content="noindex" />}
    {enableAnalytics && (
      <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}></script>
    )}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#FFF8F0" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#17121C" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="alternate icon" href={`${base}/favicon.ico`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="preload" href={`${base}/fonts/noto-sans/NotoSans[wdth,wght].woff2`} as="font" type="font/woff2" crossorigin />
    <title>{meta.title} | K-pop Quiz</title>
    <script is:inline>
      (function () {
        try {
          var savedTheme = localStorage.getItem("kpop-quiz-theme");
          if (savedTheme === "dark" || savedTheme === "light") {
            document.documentElement.setAttribute("data-theme", savedTheme);
            var color = savedTheme === "dark" ? "#17121C" : "#FFF8F0";
            var metas = document.querySelectorAll('meta[name="theme-color"]');
            for (var i = 0; i < metas.length; i++) {
              metas[i].setAttribute("content", color);
            }
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href={skipTarget}>{skipLinkText}</a>
    <header class="site-header">
      <a class="wordmark" href={`${base}/${locale === "pt-BR" ? "pt-br" : "en"}/`} aria-label={`KQ, ${messages.homeLabel}`}>
        <span>K</span>Q
      </a>
      <div class="header-actions">
        {showGameNavigation && <StatsNavTrigger locale={locale} client:load />}
        <div class="theme-control">
          <label for="theme-select" class="visually-hidden">{messages.themeLabel}</label>
          <select id="theme-select" class="theme-select" aria-label={messages.themeLabel}>
            <option value="system">{messages.themeAuto}</option>
            <option value="light">{messages.themeLight}</option>
            <option value="dark">{messages.themeDark}</option>
          </select>
        </div>
        <nav aria-label={messages.languageLabel}>
          <a class="language-link" href={`${base}${otherPath}`} hreflang={locale === "pt-BR" ? "en" : "pt-BR"}>{messages.languageName}</a>
        </nav>
      </div>
    </header>
    {showGameNavigation && (
      <nav class="game-nav-bar" aria-label={messages.gameNavLabel}>
        <div class="game-nav-container">
          {games.map((g) => (
            <a
              href={`${base}${g.path}`}
              class={`game-nav-item ${g.isActive ? "is-active" : ""}`}
              aria-current={g.isActive ? "page" : undefined}
            >
              {g.label}
            </a>
          ))}
        </div>
      </nav>
    )}
    {showGameNavigation && (
      <script is:inline>
        (function () {
          var bar = document.querySelector(".game-nav-bar");
          var list = bar && bar.querySelector(".game-nav-container");
          if (!list) return;
          var active = list.querySelector(".is-active");
          if (active && active.scrollIntoView) {
            active.scrollIntoView({ block: "nearest", inline: "center" });
          }
          function update() {
            var parts = [];
            if (list.scrollLeft > 4) parts.push("start");
            if (list.scrollLeft + list.clientWidth < list.scrollWidth - 4) parts.push("end");
            bar.setAttribute("data-overflow", parts.join(" "));
          }
          update();
          list.addEventListener("scroll", update, { passive: true });
          window.addEventListener("resize", update);
        })();
      </script>
    )}
    <main>
      <slot />
    </main>
    <footer>
      <p>
        {isMapPilot ? (
          <>{locale === "pt-BR" ? "Fontes do piloto: agenda oficial da YG; eventos MusicBrainz e Wikidata · CC0; mapa Natural Earth · domínio público." : "Pilot sources: official YG schedule; MusicBrainz and Wikidata · CC0; Natural Earth map · public domain."}</>
        ) : (
          <>{messages.attribution}: <a href="https://www.wikidata.org/wiki/Wikidata:Copyright">Wikidata · CC0</a> {messages.and} <a href="https://creativecommons.org/licenses/by-sa/4.0/">Wikipedia · CC BY-SA 4.0</a></>
        )}
        {" · "}<a href={`${base}${privacyPath}`}>{messages.privacyLink}</a>{enableGa4 && <> · <button class="footer-privacy-preferences" type="button" data-consent-preferences>{messages.consentPreferences}</button></>}
      </p>
    </footer>
    <script is:inline define:vars={{ consentPreferencesEvent: OPEN_CONSENT_PREFERENCES_EVENT }}>
      document.querySelector("[data-consent-preferences]")?.addEventListener("click", function () {
        window.dispatchEvent(new Event(consentPreferencesEvent));
      });
    </script>
    <script is:inline>
      (function () {
        var langLink = document.querySelector(".language-link");
        if (!langLink) return;

        function syncQuery() {
          if (window.location.search) {
            try {
              var target = new URL(langLink.href, window.location.origin);
              target.search = window.location.search;
              langLink.href = target.pathname + target.search + target.hash;
            } catch (e) {}
          }
        }

        syncQuery();
        langLink.addEventListener("click", syncQuery);
      })();
    </script>
    <script is:inline>
      (function () {
        var select = document.getElementById("theme-select");
        var metaLight = document.querySelector('meta[name="theme-color"][media*="light"]');
        var metaDark = document.querySelector('meta[name="theme-color"][media*="dark"]');

        function applyTheme(theme) {
          if (theme === "dark" || theme === "light") {
            document.documentElement.setAttribute("data-theme", theme);
            var color = theme === "dark" ? "#17121C" : "#FFF8F0";
            if (metaLight) metaLight.setAttribute("content", color);
            if (metaDark) metaDark.setAttribute("content", color);
          } else {
            document.documentElement.removeAttribute("data-theme");
            if (metaLight) metaLight.setAttribute("content", "#FFF8F0");
            if (metaDark) metaDark.setAttribute("content", "#17121C");
          }
        }

        function syncSelect(theme) {
          if (!select) return;
          if (theme === "dark" || theme === "light") {
            select.value = theme;
          } else {
            select.value = "system";
          }
        }

        try {
          var saved = localStorage.getItem("kpop-quiz-theme");
          syncSelect(saved);
          applyTheme(saved);
        } catch (e) {}

        if (select) {
          select.addEventListener("change", function () {
            var val = select.value;
            try {
              if (val === "dark" || val === "light") {
                localStorage.setItem("kpop-quiz-theme", val);
              } else {
                localStorage.removeItem("kpop-quiz-theme");
              }
            } catch (e) {}
            applyTheme(val);
          });
        }

        window.addEventListener("storage", function (event) {
          if (event.key === "kpop-quiz-theme") {
            var newTheme = event.newValue;
            syncSelect(newTheme);
            applyTheme(newTheme);
          }
        });
      })();
    </script>
    {enableGa4 && <ConsentBanner locale={locale} ga4Id={ga4Id} privacyUrl={`${base}${privacyPath}`} client:load />}
  </body>
</html>
