exports[`map characterization > zooms and picks on a narrow screen the same way in en > 07 whole map when Tab reaches a country out of view 1`] = `
{
  "focus": "svg.map-pilot-world-map.is-zoomable "Interactive country map. Use Tab and Enter to select a highlighted area, then press Answer."",
