exports[`map characterization > plays, finishes and shares a round on a wide screen in pt-BR > 19 analytics events 1`] = `
[
  [
    "event",
    "game_start",
    {
      "daily": "yes",
      "game": "map",
      "locale": "pt-BR",
      "send_to": "G-TEST",
    },
  ],
  [
    "event",
    "game_complete",
    {
      "daily": "yes",
      "game": "map",
      "locale": "pt-BR",
      "outcome": "win",
      "send_to": "G-TEST",
    },
  ],
  [
    "event",
    "share",
    {
      "content_type": "game_result",
      "game": "map",
      "item_id": "map",
      "locale": "pt-BR",
      "method": "clipboard",
      "send_to": "G-TEST",
    },
  ],
  [
    "event",
    "share",
    {
      "content_type": "game_result",
      "game": "map",
      "item_id": "map",
      "locale": "pt-BR",
      "method": "clipboard",
      "send_to": "G-TEST",
    },
  ],
]
`;

