---
import type { Locale } from "../lib/quiz-types";
import type { GameAboutKey } from "../i18n/game-about";
import { getMessages } from "../i18n/catalog";

interface Props {
  locale: Locale;
  game: GameAboutKey;
}

// Static text under the game island. It ships in the HTML, so crawlers and
// readers get the rules, the sources and the FAQ before any JSON loads.
const { locale, game } = Astro.props;
const { about } = getMessages(locale);
const copy = about.games[game];
const id = (suffix: string) => `game-about-${suffix}`;
---
<div class="game-about" data-testid="game-about">
  <section aria-labelledby={id("play")}>
    <h2 id={id("play")}>{about.howToPlayHeading}</h2>
    {copy.howToPlay.map((paragraph) => <p>{paragraph}</p>)}
  </section>
  <section aria-labelledby={id("data")}>
    <h2 id={id("data")}>{about.dataSourcesHeading}</h2>
    {copy.dataSources.map((paragraph) => <p>{paragraph}</p>)}
  </section>
  <section aria-labelledby={id("faq")}>
    <h2 id={id("faq")}>{about.faqHeading}</h2>
    {copy.faq.map((item) => (
      <div class="game-about-faq-item">
        <h3>{item.question}</h3>
        <p>{item.answer}</p>
      </div>
    ))}
  </section>
</div>
