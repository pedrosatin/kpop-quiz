---
import type { Locale } from "../lib/quiz-types";
import type { GameAboutKey } from "../i18n/game-about";
import { getMessages } from "../i18n/catalog";
import type { SeoRouteKey } from "../i18n/catalog";
import { SEO_ROUTES } from "../lib/seo-routes";

interface Props {
  locale: Locale;
  game: GameAboutKey;
}

// Static text under the game island. It ships in the HTML, so crawlers and
// readers get the rules, the sources and the FAQ before any JSON loads.
const { locale, game } = Astro.props;
const { about, overview } = getMessages(locale);
const copy = about.games[game];
const id = (suffix: string) => `game-about-${suffix}`;
const relatedGames = {
  grid: ["connections", "quiz"],
  connections: ["grid", "nameGuess"],
  nameGuess: ["wordSearch", "connections"],
  wordSearch: ["nameGuess", "connections"],
  mapPilot: ["timeline", "quiz"],
  timeline: ["mapPilot", "quiz"],
  code: ["timeline", "connections"],
} as const satisfies Record<GameAboutKey, readonly SeoRouteKey[]>;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const routes = relatedGames[game].map((key) =>
  SEO_ROUTES.find((route) => route.key === key && route.locale === locale)!
);
---
<div class="game-about" data-testid="game-about">
  <section aria-labelledby={id("play")}>
    <h2 id={id("play")}>{copy.howToPlayHeading}</h2>
    {copy.howToPlay.map((paragraph) => <p>{paragraph}</p>)}
  </section>
  <section aria-labelledby={id("data")}>
    <h2 id={id("data")}>{copy.dataSourcesHeading}</h2>
    {copy.dataSources.map((paragraph) => <p>{paragraph}</p>)}
  </section>
  <section aria-labelledby={id("faq")}>
    <h2 id={id("faq")}>{copy.faqHeading}</h2>
    {copy.faq.map((item) => (
      <div class="game-about-faq-item">
        <h3>{item.question}</h3>
        <p>{item.answer}</p>
      </div>
    ))}
  </section>
</div>
<section class="platform-overview" aria-labelledby="related-games-title">
  <h2 id="related-games-title">{locale === "pt-BR" ? "Outros jogos de K-pop para experimentar" : "More K-pop games to try"}</h2>
  <div class="platform-modes-grid">
    {routes.map((route) => (
      <div class="platform-mode-item">
        <h3><a href={`${base}${route.path}`}>{overview.games[route.key].title}</a></h3>
        <p>{overview.games[route.key].description}</p>
      </div>
    ))}
  </div>
</section>
