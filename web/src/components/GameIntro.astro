---
interface Props {
  kicker: string;
  title: string;
  intro: string;
  howToPlayTitle?: string;
  howToPlaySteps?: readonly string[];
  /** Match the 64rem card of games with large boards (map, word search). */
  wide?: boolean;
}

const { kicker, title, intro, howToPlayTitle, howToPlaySteps, wide = false } = Astro.props;
const hasHowToPlay = Boolean(howToPlayTitle && howToPlaySteps?.length);
---
<section
  class:list={["intro", { "intro--wide": wide, "intro--with-help": hasHowToPlay }]}
  aria-labelledby="page-title"
>
  <p class="kicker">{kicker}</p>
  <h1 id="page-title">{title}</h1>
  <p class="intro-text">{intro}</p>
  {hasHowToPlay && (
    <details class="how-to-play">
      <summary class="btn btn-secondary btn-sm">{howToPlayTitle}</summary>
      <ol class="how-to-play-steps">
        {howToPlaySteps!.map((step) => <li>{step}</li>)}
      </ol>
    </details>
  )}
</section>
