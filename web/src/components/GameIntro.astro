---
interface Props {
  /** Stable id used to remember that the player has already read the rules. */
  gameId: string;
  kicker: string;
  title: string;
  intro: string;
  howToPlayTitle?: string;
  howToPlaySteps?: readonly string[];
}

const { gameId, kicker, title, intro, howToPlayTitle, howToPlaySteps } = Astro.props;
const hasHowToPlay = Boolean(howToPlayTitle && howToPlaySteps?.length);
---
<section class="intro" aria-labelledby="page-title">
  <p class="kicker">{kicker}</p>
  <h1 id="page-title">{title}</h1>
  <p class="intro-text">{intro}</p>
  {hasHowToPlay && (
    <details class="how-to-play" data-how-to-play={gameId}>
      <summary class="btn btn-secondary btn-sm">{howToPlayTitle}</summary>
      <ol class="how-to-play-steps">
        {howToPlaySteps!.map((step) => <li>{step}</li>)}
      </ol>
    </details>
  )}
</section>
{hasHowToPlay && (
  <script is:inline define:vars={{ gameId }}>
    (function () {
      var details = document.querySelector('[data-how-to-play="' + gameId + '"]');
      if (!details) return;
      var key = "kpop-quiz-how-to-play-seen:" + gameId;
      try {
        // Open the rules on the first visit to each game, then remember it.
        if (!localStorage.getItem(key)) {
          details.open = true;
          localStorage.setItem(key, "1");
        }
      } catch (e) {}
    })();
  </script>
)}
