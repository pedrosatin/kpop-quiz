---
import { WordSearchGame } from "../../components/WordSearch/WordSearchGame";
import GameIntro from "../../components/GameIntro.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getMessages } from "../../i18n/catalog";

const messages = getMessages("en");
---
<BaseLayout locale="en" route="wordSearch" canonicalPath="/en/word-search/" alternatePath="/pt-br/caca-palavras/">
  <div class="page-shell">
    <GameIntro
      kicker={messages.wordSearchEyebrow}
      title={messages.wordSearchTitle}
      howToPlayTitle={messages.howToPlayTitle}
      howToPlaySteps={messages.wordSearchHowToPlay}
      intro={messages.wordSearchIntro}
    />
    <WordSearchGame locale="en" client:load />
  </div>
</BaseLayout>
