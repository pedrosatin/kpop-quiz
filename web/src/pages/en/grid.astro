---
import { IntersectionGrid } from "../../components/Grid/IntersectionGrid";
import GameAbout from "../../components/GameAbout.astro";
import GameIntro from "../../components/GameIntro.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getMessages } from "../../i18n/catalog";

const messages = getMessages("en");
---
<BaseLayout locale="en" route="grid" canonicalPath="/en/grid/" alternatePath="/pt-br/grid/">
  <div class="page-shell" data-testid="game-shell">
    <GameIntro
      wide
      kicker={messages.gridEyebrow}
      title={messages.gridTitle}
      howToPlayTitle={messages.howToPlayTitle}
      howToPlaySteps={messages.gridHowToPlay}
      intro={messages.gridIntro}
    />
    <IntersectionGrid locale="en" client:load />
    <GameAbout locale="en" game="grid" />
  </div>
</BaseLayout>
