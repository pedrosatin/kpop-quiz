---
import { ConnectionsGame } from "../../components/Connections/ConnectionsGame";
import GameIntro from "../../components/GameIntro.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getMessages } from "../../i18n/catalog";

const messages = getMessages("en");
---
<BaseLayout locale="en" route="connections" canonicalPath="/en/connections/" alternatePath="/pt-br/conexoes/">
  <div class="page-shell">
    <GameIntro
      gameId="connections"
      kicker={messages.connectionsEyebrow}
      title={messages.connectionsTitle}
      howToPlayTitle={messages.howToPlayTitle}
      howToPlaySteps={messages.connectionsHowToPlay}
      intro={messages.connectionsIntro}
    />
    <ConnectionsGame locale="en" client:load />
  </div>
</BaseLayout>
