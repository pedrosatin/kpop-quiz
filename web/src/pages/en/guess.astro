---
import { NameGuessGame } from "../../components/NameGuess/NameGuessGame";
import GameAbout from "../../components/GameAbout.astro";
import GameIntro from "../../components/GameIntro.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getMessages } from "../../i18n/catalog";

const messages = getMessages("en");
---
<BaseLayout locale="en" route="nameGuess" canonicalPath="/en/guess/" alternatePath="/pt-br/adivinhe/">
  <div class="page-shell" data-testid="game-shell">
    <GameIntro
      wide
      kicker={messages.nameGuessEyebrow}
      title={messages.nameGuessTitle}
      howToPlayTitle={messages.howToPlayTitle}
      howToPlaySteps={messages.nameGuessHowToPlay}
      intro={messages.nameGuessIntro}
    />
    <NameGuessGame locale="en" client:load />
    <GameAbout locale="en" game="nameGuess" />
  </div>
</BaseLayout>
