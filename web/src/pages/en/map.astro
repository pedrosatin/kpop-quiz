---
import { MapPilotGame } from "../../components/MapPilot/MapPilotGame";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getMessages } from "../../i18n/catalog";

const messages = getMessages("en");
---
<BaseLayout locale="en" route="mapPilot" canonicalPath="/en/map/" alternatePath="/pt-br/mapa/">
  <div class="page-shell page-shell--map-pilot">
    <section class="intro" aria-labelledby="page-title">
      <p class="kicker">{messages.mapEyebrow}</p>
      <h1 id="page-title">{messages.mapTitle}</h1>
      <p class="intro-text">{messages.mapIntro}</p>
    </section>
    <MapPilotGame locale="en" client:load />
  </div>
</BaseLayout>
