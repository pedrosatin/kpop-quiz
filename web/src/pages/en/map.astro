---
import { MapPilotGame } from "../../components/MapPilot/MapPilotGame";
import BaseLayout from "../../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<BaseLayout locale="en" route="mapPilot" canonicalPath="/en/map/" alternatePath="/pt-br/mapa/" indexable={false}>
  <div class="page-shell page-shell--map-pilot">
    <section class="intro" aria-labelledby="page-title">
      <p class="kicker">PILOT · DEADLINE WORLD TOUR</p>
      <h1 id="page-title">Map quiz: BLACKPINK</h1>
      <p>Use the official tour schedule to locate each date on the map. The pilot has 31 candidate dates, each linked to a source you can inspect.</p>
      <p class="map-pilot-notice">A date on the schedule does not confirm that the show took place. The data and source policy are still under review.</p>
      <div class="game-mode-switch">
        <a class="switch-link" href={`${base}/en/`}>← Back to quiz</a>
      </div>
    </section>
    <MapPilotGame locale="en" client:load />
  </div>
</BaseLayout>
