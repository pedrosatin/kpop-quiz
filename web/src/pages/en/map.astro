---
import { MapPilotGame } from "../../components/MapPilot/MapPilotGame";
import GameIntro from "../../components/GameIntro.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getMessages } from "../../i18n/catalog";

const messages = getMessages("en");
---
<BaseLayout locale="en" route="mapPilot" canonicalPath="/en/map/" alternatePath="/pt-br/mapa/">
  <div class="page-shell">
    <GameIntro
      wide
      kicker={messages.mapEyebrow}
      title={messages.mapTitle}
      howToPlayTitle={messages.howToPlayTitle}
      howToPlaySteps={messages.mapHowToPlay}
      intro={messages.mapIntro}
    />
    <MapPilotGame locale="en" client:load />
  </div>
</BaseLayout>
