---
import { NameGuessGame } from "../../components/NameGuess/NameGuessGame";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getMessages } from "../../i18n/catalog";

const messages = getMessages("pt-BR");
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<BaseLayout locale="pt-BR" route="nameGuess" canonicalPath="/pt-br/adivinhe/" alternatePath="/en/guess/">
  <div class="page-shell">
    <section class="intro" aria-labelledby="page-title">
      <p class="kicker">{messages.nameGuessEyebrow}</p>
      <h1 id="page-title">{messages.nameGuessTitle}</h1>
      <p>{messages.nameGuessIntro}</p>
      <div class="game-mode-switch">
        <a class="switch-link" href={`${base}/pt-br/`}>
          ← {messages.quizModeLink}
        </a>
      </div>
    </section>
    <NameGuessGame locale="pt-BR" client:load />
  </div>
</BaseLayout>
