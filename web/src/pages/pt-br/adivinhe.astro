---
import { NameGuessGame } from "../../components/NameGuess/NameGuessGame";
import GameIntro from "../../components/GameIntro.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getMessages } from "../../i18n/catalog";

const messages = getMessages("pt-BR");
---
<BaseLayout locale="pt-BR" route="nameGuess" canonicalPath="/pt-br/adivinhe/" alternatePath="/en/guess/">
  <div class="page-shell">
    <GameIntro
      gameId="name-guess"
      kicker={messages.nameGuessEyebrow}
      title={messages.nameGuessTitle}
      intro={messages.nameGuessIntro}
    />
    <NameGuessGame locale="pt-BR" client:load />
  </div>
</BaseLayout>
