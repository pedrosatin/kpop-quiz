---
import { ConnectionsGame } from "../../components/Connections/ConnectionsGame";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getMessages } from "../../i18n/catalog";

const messages = getMessages("pt-BR");
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<BaseLayout locale="pt-BR" route="connections" canonicalPath="/pt-br/conexoes/" alternatePath="/en/connections/">
  <div class="page-shell">
    <section class="intro" aria-labelledby="page-title">
      <p class="kicker">{messages.connectionsEyebrow}</p>
      <h1 id="page-title">{messages.connectionsTitle}</h1>
      <p>{messages.connectionsIntro}</p>
      <div class="game-mode-switch">
        <a class="switch-link" href={`${base}/pt-br/`}>
          ← {messages.quizModeLink}
        </a>
      </div>
    </section>
    <ConnectionsGame locale="pt-BR" client:load />
  </div>
</BaseLayout>
