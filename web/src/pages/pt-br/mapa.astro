---
import { MapPilotGame } from "../../components/MapPilot/MapPilotGame";
import GameAbout from "../../components/GameAbout.astro";
import GameIntro from "../../components/GameIntro.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getMessages } from "../../i18n/catalog";

const messages = getMessages("pt-BR");
---
<BaseLayout locale="pt-BR" route="mapPilot" canonicalPath="/pt-br/mapa/" alternatePath="/en/map/">
  <div class="page-shell" data-testid="game-shell">
    <GameIntro
      wide
      kicker={messages.mapEyebrow}
      title={messages.mapTitle}
      howToPlayTitle={messages.howToPlayTitle}
      howToPlaySteps={messages.mapHowToPlay}
      intro={messages.mapIntro}
    />
    <MapPilotGame locale="pt-BR" client:load />
    <GameAbout locale="pt-BR" game="mapPilot" />
  </div>
</BaseLayout>
