---
import { TimelineGame } from "../../components/Timeline/TimelineGame";
import GameAbout from "../../components/GameAbout.astro";
import GameIntro from "../../components/GameIntro.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getMessages } from "../../i18n/catalog";

const messages = getMessages("pt-BR");
---
<BaseLayout locale="pt-BR" route="timeline" canonicalPath="/pt-br/linha-do-tempo/" alternatePath="/en/timeline/">
  <div class="page-shell" data-testid="game-shell">
    <GameIntro
      wide
      kicker={messages.timelineEyebrow}
      title={messages.timelineTitle}
      howToPlayTitle={messages.howToPlayTitle}
      howToPlaySteps={messages.timelineHowToPlay}
      intro={messages.timelineIntro}
    />
    <TimelineGame locale="pt-BR" client:load />
    <GameAbout locale="pt-BR" game="timeline" />
  </div>
</BaseLayout>
