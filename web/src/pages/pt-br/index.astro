---
import { Quiz } from "../../components/Quiz/Quiz";
import GameIntro from "../../components/GameIntro.astro";
import PlatformOverview from "../../components/PlatformOverview.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { initialQuizDecades } from "../../data/build-manifest";
import { getMessages } from "../../i18n/catalog";

const messages = getMessages("pt-BR");
const initialAvailableDecades = initialQuizDecades();
---
<BaseLayout locale="pt-BR" route="quiz" canonicalPath="/pt-br/" alternatePath="/en/">
  <div class="page-shell" data-testid="game-shell">
    <GameIntro
      wide
      kicker={messages.eyebrow}
      title={messages.title}
      howToPlayTitle={messages.howToPlayTitle}
      howToPlaySteps={messages.quizHowToPlay}
      intro={messages.intro}
    />
    <Quiz locale="pt-BR" initialAvailableDecades={initialAvailableDecades} client:load />
    <PlatformOverview locale="pt-BR" />
  </div>
</BaseLayout>
