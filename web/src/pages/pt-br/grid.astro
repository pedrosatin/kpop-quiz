---
import { IntersectionGrid } from "../../components/Grid/IntersectionGrid";
import GameIntro from "../../components/GameIntro.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getMessages } from "../../i18n/catalog";

const messages = getMessages("pt-BR");
---
<BaseLayout locale="pt-BR" route="grid" canonicalPath="/pt-br/grid/" alternatePath="/en/grid/">
  <div class="page-shell">
    <GameIntro
      kicker={messages.gridEyebrow}
      title={messages.gridTitle}
      howToPlayTitle={messages.howToPlayTitle}
      howToPlaySteps={messages.gridHowToPlay}
      intro={messages.gridIntro}
    />
    <IntersectionGrid locale="pt-BR" client:load />
  </div>
</BaseLayout>
