---
import { StrandsGame } from "../../components/Strands/StrandsGame";
import GameAbout from "../../components/GameAbout.astro";
import GameIntro from "../../components/GameIntro.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getMessages } from "../../i18n/catalog";

const messages = getMessages("pt-BR");
---
<BaseLayout locale="pt-BR" route="strands" canonicalPath="/pt-br/palavras-conectadas/" alternatePath="/en/strands/">
  <div class="page-shell" data-testid="game-shell">
    <GameIntro
      wide
      kicker={messages.strandsEyebrow}
      title={messages.strandsTitle}
      howToPlayTitle={messages.howToPlayTitle}
      howToPlaySteps={messages.strandsHowToPlay}
      intro={messages.strandsIntro}
    />
    <StrandsGame locale="pt-BR" client:load />
    <GameAbout locale="pt-BR" game="strands" />
  </div>
</BaseLayout>
