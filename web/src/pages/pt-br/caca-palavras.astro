---
import { WordSearchGame } from "../../components/WordSearch/WordSearchGame";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getMessages } from "../../i18n/catalog";

const messages = getMessages("pt-BR");
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<BaseLayout locale="pt-BR">
  <div class="page-shell">
    <section class="intro" aria-labelledby="page-title">
      <p class="kicker">{messages.wordSearchEyebrow}</p>
      <h1 id="page-title">{messages.wordSearchTitle}</h1>
      <p>{messages.wordSearchIntro}</p>
      <div class="game-mode-switch">
        <a class="switch-link" href={`${base}/pt-br/`}>
          ← {messages.quizModeLink}
        </a>
      </div>
    </section>
    <WordSearchGame locale="pt-BR" client:load />
  </div>
</BaseLayout>
