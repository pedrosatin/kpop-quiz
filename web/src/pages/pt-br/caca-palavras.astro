---
import { WordSearchGame } from "../../components/WordSearch/WordSearchGame";
import GameIntro from "../../components/GameIntro.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getMessages } from "../../i18n/catalog";

const messages = getMessages("pt-BR");
---
<BaseLayout locale="pt-BR" route="wordSearch" canonicalPath="/pt-br/caca-palavras/" alternatePath="/en/word-search/">
  <div class="page-shell page-shell--wide">
    <GameIntro
      gameId="word-search"
      kicker={messages.wordSearchEyebrow}
      title={messages.wordSearchTitle}
      intro={messages.wordSearchIntro}
    />
    <WordSearchGame locale="pt-BR" client:load />
  </div>
</BaseLayout>
